# ============================================================
# Restaurant Billing — .gitignore
# Public repo. Ye file ensure karti hai ki koi secret
# accidentally commit na ho jaaye.
# ============================================================

# ---------- Node / dependencies ----------
node_modules/
package-lock.json
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- Cloudflare Worker ----------
.wrangler/
workers/.dev.vars
workers/.dev.vars.*
workers/dist/
workers/.mf/

# ---------- Environment files ----------
.env
.env.*
!.env.example
*.local

# ---------- Firebase ----------
.firebase/
firebase-debug.log
firebase-debug.*.log
.firebaserc
firebase/firebase.json

# ---------- Service account / credentials ----------
service-account*.json
*-service-account*.json
*-firebase-adminsdk-*.json
*.pem
*.key
*.p12
*.pfx
credentials.json
secrets.json

# ---------- Build artifacts ----------
dist/
build/
out/
.cache/
.parcel-cache/

# ---------- Editor / OS ----------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ---------- Logs ----------
*.log
logs/
coverage/

# ---------- Temporary ----------
tmp/
temp/
*.tmp
